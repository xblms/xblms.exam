@page
@{ Layout = "_Layout"; }
@section Styles{
    <link href="/sitefiles/assets/lib/geeks/css/theme.min.css" rel="stylesheet" type="text/css" />
    <style>
        html, body {
            padding: 0;
            margin: 0;
            background-color: #f1f1f1;
            overflow:hidden !important;
        }
    </style>
}

<div class="row d-flex flex-column align-items-center justify-content-center vh-100">
    <div class="col-8">
        <el-card class="py-5">
            <el-result icon="error" v-if="par">
                <template slot="title">
                    系统错误
                </template>
                <template slot="subTitle">
                    <div v-if="xblmscheck">
                        未初始化系统安装
                    </div>
                    <div v-else>
                        无法连接到远程数据库，请检查数据库连接
                    </div>
                </template>
                <template slot="extra" v-if="xblmscheck">
                    <el-button type="primary" v-on:click="top.location.href='/xblms-admin/install'">去安装系统</el-button>
                </template>
                <template slot="extra" v-else>
                    <el-button type="primary" v-on:click="top.location.href='/home/'">重新尝试</el-button>
                </template>
            </el-result>
            <el-result v-else icon="success" title="系统运行正常" subTitle="">
              <template slot="extra">
                <el-button type="primary" v-on:click="top.location.href='/home/'">返回用户中心</el-button>
              </template>
            </el-result>
        </el-card>
    </div>
</div>

@section Scripts{
  <script src="/sitefiles/assets/js/admin/installCheck.js" type="text/javascript"></script>
}