@page
@{ Layout = "_Layout"; }
@section Styles{
    <link href="/sitefiles/assets/lib/geeks/css/theme.min.css" rel="stylesheet" type="text/css" />
}
<el-card>
     <el-form v-on:submit.native.prevent :inline="true" :size="euiSize" class="pe-0" id="sform">
                <el-form-item label="题目">
                    <el-input clearable v-model="formInline.keyWords" placeholder="关键字" prefix-icon="el-icon-search"></el-input>
                </el-form-item>
                <el-form-item label="状态">
                    <el-select v-model="formInline.status" placeholder="全部状态" v-on:change="btnSearchClick" clearable>
                        <el-option label="全部状态" :value="0"></el-option>
                        <el-option label="已入库" :value="1"></el-option>
                        <el-option label="未入库" :value="2"></el-option>
                    </el-select>
                </el-form-item>
                <el-form-item>
                    <el-button plain icon="el-icon-search" type="primary" v-on:click="btnSearchClick">查 询</el-button>
                </el-form-item>
                 <el-form-item class="m-0">
                    <el-button icon="el-icon-plus" type="success" v-on:click="btnPublishClick">AI出题</el-button>
                    <el-dropdown :show-timeout="0" placement="bottom" style="margin-left:10px;">
                        <el-button :size="euiSize" v-on:click.stop="return false">
                            更多操作<i class="el-icon-arrow-down el-icon--down"></i>
                        </el-button>
                        <el-dropdown-menu slot="dropdown">
                            <el-dropdown-item icon="el-icon-plus" v-on:click.native="btnRukusClick">未入库的全部入库</el-dropdown-item>
                            <el-dropdown-item icon="el-icon-delete" v-on:click.native="btnDeletesClick" style="color:red;">删除已入库</el-dropdown-item>
                        </el-dropdown-menu>
                    </el-dropdown>
                </el-form-item>
            </el-form>
             <el-table ref="tmTable" :data="tmList" :size="euiSize"  :height="$(window).height()-160">
                <el-table-column label="#"
                                 type="index"
                                 width="60"
                                 align="left">
                    <template scope="scope">
                        <span>{{(formInline.pageIndex - 1) * formInline.pageSize + scope.$index + 1}}</span>
                    </template>
                </el-table-column>
                <el-table-column show-overflow-tooltip prop="title" label="题目">
                    <template slot-scope="scope">
                        <el-link type="primary" :underline="false" v-on:click="handleCommand('info',scope.row)">
                            <span v-html="scope.row.title"></span>
                        </el-link>
                    </template>
                </el-table-column>
                <el-table-column prop="txName" label="题型" width="80" show-overflow-tooltip>
                </el-table-column>
                <el-table-column prop="score" label="分数" width="63">
                </el-table-column>
                <el-table-column label="难度" width="63">
                    <template slot-scope="scope">
                        <span v-html="scope.row.nanduStar"></span>
                    </template>
                </el-table-column>
                <el-table-column label="状态" width="85">
                    <template slot-scope="scope">
                        <span v-if="scope.row.stocked"><el-tag size="mini" type="success">已入库</el-tag></span>
                        <span v-else><el-tag size="mini" type="warning" effect="dark">未入库</el-tag></span>
                    </template>
                </el-table-column>
                <el-table-column prop="createdDateStr" label="创建时间"
                                 width="150">
                </el-table-column>
                <el-table-column width="100" align="right">
                    <template slot-scope="scope">
                        <el-dropdown :show-timeout="0" placement="left">
                            <el-button icon="el-icon-arrow-left" size="mini" v-on:click.stop="return false">
                                操作
                            </el-button>
                            <el-dropdown-menu slot="dropdown">
                                <el-dropdown-item v-if="!scope.row.stocked" icon="el-icon-s-promotion" v-on:click.native="handleCommand('ruku',scope.row)">入库</el-dropdown-item>
                                <el-dropdown-item icon="el-icon-edit" v-on:click.native="handleCommand('edit',scope.row)">修改</el-dropdown-item>
                                <el-dropdown-item icon="el-icon-delete" v-on:click.native="handleCommand('del',scope.row)" style="color:red;" divided>删除</el-dropdown-item>
                            </el-dropdown-menu>
                        </el-dropdown>
                    </template>
                </el-table-column>
                @await Html.PartialAsync("_PartialTableEmpty")
            </el-table>
               <div style="text-align: center; margin-top: 10px;">
                <el-pagination v-on:current-change="handleCurrentChange" background
                               :current-page="formInline.pageIndex"
                               v-on:size-change="handleSizeChange"
                               :page-size="formInline.pageSize"
                               :page-sizes="pageSizes"
                               layout="total,sizes, prev, pager, next, jumper"
                               :total="total">
                </el-pagination>
            </div>
</el-card>
<template>
    <el-drawer title="选择一个题库" destroy-on-close
               size="40%"
               :visible.sync="drawerSelectTk"
               direction="rtl">
        <div class="px-3">
            <el-scrollbar class="scrollbar" :style="{ height: ($(window).innerHeight()-150) + 'px' }">
                <el-tree class="filter-tree"
                         :data="treeItems"
                         v-on:node-click="treeNodeClick"
                         v-on:node-contextmenu="treeNodeContextmenu"
                         v-on:node-expand="treeNodeExpand"
                         v-on:node-collapse="treeNodeCollapse"
                         node-key="value"
                         accordion
                         highlight-current
                         :default-expanded-keys="treeDefaultExpandedKeys"
                         :filter-node-method="treeFilterNode"
                         ref="tree">
                    <template slot-scope="{ node,data }">
                        <span class="w-100 pt-1 fs-5">{{ node.label }}<span class="tips">({{ data.selfTotal }}/{{ data.total }})</span></span>
                    </template>
                </el-tree>
            </el-scrollbar>
            <div class="my-2 text-center">
                <span class="tips text-warning"><span v-if="treeSelectId && treeSelectId>0">{{ treeSelectName }}</span><span v-else>请选择一个题库分类</span></span>
            </div>
            <div class="text-center">
                <el-button size="small" type="primary" v-on:click="btnSelectTkConfirmClick" icon="el-icon-check">确定入库</el-button>
                <el-button size="small" type="info" v-on:click="drawerSelectTk=!drawerSelectTk" icon="el-icon-close">取 消</el-button>
            </div>
        </div>
    </el-drawer>
</template>
@section Scripts{
    <script src="/sitefiles/assets/js/admin/exam/examTmAi.js" type="text/javascript"></script>
}